# ZFinance Reconciliation Agent — environment variables

# LLM Provider: "groq" (recommended) or "ollama" (local)
LLM_PROVIDER=groq

# Groq API key — free at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Model to use
# Groq options: llama3-8b-8192 | mixtral-8x7b-32768
# Ollama options: llama3.1 | phi4-mini | mistral
LLM_MODEL=llama3-8b-8192

# Matching thresholds (tune these based on your data)
AMOUNT_TOLERANCE=1.0       # ₹ window for exact match
DATE_TOLERANCE=0           # days window for exact match
FUZZY_DATE_WINDOW=3        # days window for LLM candidates
FUZZY_AMOUNT_PCT=5.0       # % window for LLM candidates
CONFIDENCE_ACCEPT=0.75     # minimum LLM confidence to accept a fuzzy match
